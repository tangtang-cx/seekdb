# Dify 接口地址
DIFY_BASE_URL=https://cloud.dify.ai

# 知识库 API Key：Dify -> 知识库 -> API -> Knowledge API key
DIFY_API_KEY=

# 知识库名称
DIFY_DATASET_NAME=OceanBase-Vector-DB

# embedding 模型（需在工作空间中已配置对应 provider）
DIFY_EMBEDDING_PROVIDER=tongyi
DIFY_EMBEDDING_MODEL=text-embedding-v3
DIFY_EMBEDDING_MODEL_TYPE=text-embedding

# 控制台会话 token（浏览器 DevTools -> Application -> Cookies -> console-token）
# 仅用于脚本导入 DSL；用 UI 导入可留空
DIFY_CONSOLE_TOKEN=
